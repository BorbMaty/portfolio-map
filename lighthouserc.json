{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4323",
      "startServerReadyPattern": "localhost:4323",
      "url": ["http://localhost:4323/", "http://localhost:4323/cv/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 307200, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
