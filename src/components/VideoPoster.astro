---
/**
 * Click-to-load YouTube player: shows a poster button and only inserts the iframe after a click,
 * so no YouTube scripts or cookies load until the visitor asks for the video.
 * Props: id — YouTube video id; title — accessible name of the video; poster — optional local poster image.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  poster?: ImageMetadata;
}
const { id, title, poster } = Astro.props;
---

<div class="video" data-youtube-id={id} data-title={title}>
  <button type="button" class="play">
    {poster && <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 860px" loading="eager" fetchpriority="high" />}
    <span class="label">Play video: {title}</span>
  </button>
</div>

<script>
  // Replace the poster with the player on click. youtube-nocookie avoids tracking cookies until playback.
  document.querySelectorAll<HTMLElement>('.video[data-youtube-id]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.youtubeId ?? '')}?autoplay=1`;
      iframe.title = box.dataset.title ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .play,
  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    position: relative;
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .label {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    font-weight: 600;
  }
</style>
