---
/**
 * The project panel: hero, title, region, pitch, metrics, stack, role/period, body (slot) and links.
 * Used by /projects/<slug> now; phase 2 reuses it inside the map's scroll panel.
 * Props: project — a `projects` collection entry. The rendered MDX body goes in the default slot.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import VideoPoster from './VideoPoster.astro';
import Gallery from './Gallery.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, region, pitch, metrics, stack, role, period, links, hero, gallery } = project.data;
---

<article class="panel">
  <div class="hero">
    {
      hero.kind === 'youtube' ? (
        <VideoPoster id={hero.src} title={hero.alt} poster={hero.poster} />
      ) : (
        <Image src={hero.src} alt={hero.alt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 860px" loading="eager" fetchpriority="high" />
      )
    }
  </div>

  <header>
    <p class="region">{region}</p>
    <h1>{title}</h1>
    <p class="pitch">{pitch}</p>
  </header>

  {
    metrics.length > 0 && (
      <dl class="metrics">
        {metrics.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="chips" aria-label="Tech stack">
    {stack.map((s) => <li>{s}</li>)}
  </ul>

  <p class="meta"><strong>Role:</strong> {role} · <strong>Period:</strong> {period}</p>

  <div class="body">
    <slot />
  </div>

  <Gallery images={gallery} />

  {
    links.length > 0 && (
      <section class="links" aria-labelledby="links-heading">
        <h2 id="links-heading">Links</h2>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href} data-kind={l.kind}>{l.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>

<style>
  .panel {
    max-width: 54rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem;
  }
  .hero :global(img) {
    display: block;
    width: 100%;
    border-radius: var(--radius);
  }
  .region {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0.25rem 0;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  .pitch {
    font-size: 1.15rem;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .metrics div {
    padding: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .metrics dt {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .metrics dd {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .meta {
    color: var(--muted);
  }
  .body :global(img) {
    display: block;
    margin-block: 1rem;
    border-radius: var(--radius);
  }
</style>
