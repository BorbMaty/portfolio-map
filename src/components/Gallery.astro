---
/**
 * Lazy-loaded screenshot grid for a project, with a lightbox: a thumbnail opens the full-size image in a modal
 * <dialog> with close (×, Esc, backdrop click) and previous/next (arrows, ← →) controls that wrap around.
 * Without JavaScript each thumbnail is still a plain link to the full-size image.
 * Props: images — the project's `gallery` frontmatter entries ({ src, alt }), shown in order.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}
const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section aria-labelledby="gallery-heading" data-gallery>
      <h2 id="gallery-heading">Gallery</h2>
      <ul class="gallery" role="list">
        {images.map((img) => (
          <li>
            <a href={img.src.src}>
              <Image src={img.src} alt={img.alt} widths={[320, 640]} sizes="(max-width: 640px) 100vw, 320px" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>

      {/* The full-size <img> is created by the script on first open (see `show`). */}
      <dialog class="lightbox" aria-label="Image viewer">
        <button class="close" type="button" aria-label="Close">×</button>
        <button class="nav prev" type="button" aria-label="Previous image">‹</button>
        <figure>
          <figcaption></figcaption>
        </figure>
        <button class="nav next" type="button" aria-label="Next image">›</button>
        <p class="count" aria-live="polite"></p>
      </dialog>
    </section>
  )
}

<script>
  // Native <dialog> + showModal() gives the focus trap, Esc to close and the backdrop for free.
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.gallery a')];
    const dialog = root.querySelector('dialog')!;
    const figure = dialog.querySelector('figure')!;
    const caption = dialog.querySelector('figcaption')!;
    const count = dialog.querySelector<HTMLElement>('.count')!;
    let full: HTMLImageElement | undefined;
    let current = 0;
    let opener: HTMLAnchorElement | undefined;

    // Show image i, wrapping past either end (last -> first, first -> last).
    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      // Created on first open, so the page never holds an <img> without src and alt.
      if (!full) {
        full = document.createElement('img');
        figure.prepend(full);
      }
      full.src = link.href;
      full.alt = link.querySelector('img')?.alt ?? '';
      caption.textContent = full.alt;
      count.textContent = `${current + 1} / ${links.length}`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (event) => {
        event.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );
    // A single image has nowhere to go: hide the arrows.
    for (const nav of dialog.querySelectorAll<HTMLElement>('.nav')) nav.hidden = links.length < 2;
    dialog.querySelector('.prev')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.next')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    // The dialog fills the viewport; a click that lands on the dialog itself (not the image or a button) is the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (links.length < 2) return;
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    // Return focus to the thumbnail that opened the viewer, so keyboard users keep their place.
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .gallery img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  /* Full-viewport, transparent dialog: the dark ::backdrop shows through, the image sits centred. */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.92);
  }
  figure {
    margin: 0;
    max-width: calc(100vw - 8rem);
    text-align: center;
  }
  figure :global(img) {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 7rem);
    margin-inline: auto;
    object-fit: contain;
    border-radius: var(--radius);
  }
  figcaption,
  .count {
    color: #fff;
  }
  figcaption {
    margin-top: 0.5rem;
  }
  .count {
    position: absolute;
    top: 0.75rem;
    left: 1rem;
    margin: 0;
  }
  /* White on 60 % black: well above 4.5:1 on any image; 2.75rem keeps a comfortable touch target. */
  button {
    position: absolute;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  button:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .close {
    top: 0.75rem;
    right: 1rem;
  }
  .prev {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }
  @media (max-width: 640px) {
    figure {
      max-width: 100vw;
    }
    /* Arrows move to the bottom on phones so they don't cover the image. */
    .nav {
      top: auto;
      bottom: 1rem;
    }
  }
</style>
