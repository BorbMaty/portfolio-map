---
/**
 * Lazy-loaded screenshot grid for a project; each thumbnail links to the full-size image.
 * Props: images — the project's `gallery` frontmatter entries ({ src, alt }), shown in order.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}
const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section aria-labelledby="gallery-heading">
      <h2 id="gallery-heading">Gallery</h2>
      <ul class="gallery" role="list">
        {images.map((img) => (
          <li>
            <a href={img.src.src}>
              <Image src={img.src} alt={img.alt} widths={[320, 640]} sizes="(max-width: 640px) 100vw, 320px" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .gallery img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
</style>
