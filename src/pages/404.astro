---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This part of the map is uncharted." noindex>
  <div class="wrap lost">
    <h1>Here be dragons</h1>
    <p>This part of the map is uncharted.</p>
    <p><a class="button primary" href="/">Back to the map</a></p>
  </div>
</Base>

<style>
  .lost {
    padding-block: 4rem;
    text-align: center;
  }
</style>
